{
  "expo": {
    "name": "Dubai Maps",
    "slug": "dubai-maps",
    "scheme": "dubaimaps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0810",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0810"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dubaimaps.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Dubai Maps shows your position on the map and guides you to malls, missions and places.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dubaimaps.app",
      "adaptiveIcon": {
        "backgroundColor": "#2A0E4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Dubai Maps"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dubai Maps shows your position on the map and guides you to malls, missions and places."
        }
      ]
    ]
  }
}
